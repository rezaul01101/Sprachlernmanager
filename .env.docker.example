## Env file for the Dockerized stack (app + mysql services). Kept separate
## from the plain .env used by a host-based (e.g. Herd) dev setup so the two
## never collide — different DB credentials, different ports, no shared
## MySQL instance.
##
## Copy this to `.env.docker`, fill in real secrets, then:
##   dev:  docker compose up -d --build
##   prod: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

APP_NAME="Sprachbahnhof Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

## --- Database ---------------------------------------------------------------
# DB_HOST is the `mysql` service name (Docker's internal DNS resolves it) —
# not 127.0.0.1, since MySQL runs in its own container, reachable over the
# `laravel` network defined in docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=german-manager
DB_USERNAME=sprachbahnhof
# Real password required — generate one with: openssl rand -base64 24
DB_PASSWORD=

# The official mysql:8.4 image's own entrypoint reads these MYSQL_* names
# (not the DB_* ones above) to create the database/user on first boot — kept
# in sync with the DB_* values by hand, since Laravel and the MySQL image
# each hardcode their own variable names.
MYSQL_DATABASE=german-manager
MYSQL_USER=sprachbahnhof
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

## --- Docker Compose only (not read by Laravel) -----------------------------
# Host-side port mappings — kept off 80/3306 by default so they don't collide
# with a host-based MySQL/Herd/nginx already using those.
APP_PORT=8090
VITE_PORT=5183
DB_EXPOSE_PORT=3317
# Run seeders on every container start (dev convenience only — never set this
# for a production stack, it's not idempotent against real user data).
SEED_ON_BOOT=false
